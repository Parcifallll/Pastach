# Kafka Configuration (producer)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# RECOMMENDATION SYSTEM (Python microservice)
RECSYS_PORT=8000

# gRPC Client Configuration (connecting to Python recommendation service)
RECSYS_GRPC_HOST=localhost
RECSYS_GRPC_PORT=50051

# PostgreSQL Configuration
RECSYS_POSTGRES_HOST=localhost
RECSYS_POSTGRES_PORT=5434
RECSYS_POSTGRES_DB=recommendations
RECSYS_POSTGRES_USER=postgres
RECSYS_POSTGRES_PASSWORD=password

# Redis Configuration (for ML service caching)
RECSYS_REDIS_HOST=localhost
RECSYS_REDIS_PORT=6380
RECSYS_REDIS_DB=0
RECSYS_REDIS_PASSWORD=password
RECSYS_REDIS_TTL=86400